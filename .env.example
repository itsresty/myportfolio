# Create credentials with `npm run admin:create`, then add the generated values
# to .env.local. Do not commit .env.local.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD_HASH=210000:generated-salt:generated-password-hash
ADMIN_SESSION_SECRET=generated-long-random-secret

# Add a public booking page URL from Google Calendar Appointment Schedules,
# Cal.com, or Calendly to show live availability on /contact.
NEXT_PUBLIC_CALENDAR_BOOKING_URL=https://calendly.com/your-username

# Supabase (required for persistent admin CRUD on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only: never prefix these values with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
